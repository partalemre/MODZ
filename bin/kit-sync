#!/usr/bin/env bash
# Copy the MODZ kit (kit/*.ts, kit/*.tsx) into <mod>/hooks/kit/, byte for byte.
# Usage: bin/kit-sync [mod ...]   a mod is a name under mods/ or .staging/, or a plugin folder.
# With no mods: every mod under mods/ and .staging/ that already has hooks/kit.
# Writes only inside <mod>/hooks/kit/; never deletes. Kit files there that kit/ no longer
# has are listed as stale for you to remove.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KIT="$ROOT/kit"
shopt -s nullglob

resolve() {
  if [[ -d "$1/hooks" ]]; then (cd "$1" && pwd); return; fi
  if [[ -d "$ROOT/$1/hooks" ]]; then (cd "$ROOT/$1" && pwd); return; fi
  for base in "$ROOT/mods" "$ROOT/.staging"; do
    if [[ -d "$base/$1/hooks" ]]; then echo "$base/$1"; return; fi
  done
  echo "kit-sync: no plugin with hooks/ at '$1'" >&2; return 1
}

targets=()
if [[ $# -gt 0 ]]; then
  for arg in "$@"; do targets+=("$(resolve "$arg")"); done
else
  for dir in "$ROOT"/mods/*/hooks/kit "$ROOT"/.staging/*/hooks/kit; do targets+=("$(dirname "$(dirname "$dir")")"); done
fi
[[ ${#targets[@]} -gt 0 ]] || { echo "kit-sync: nothing to sync (no mod has hooks/kit; name one)"; exit 0; }

sources=("$KIT"/*.ts "$KIT"/*.tsx)
for mod in "${targets[@]}"; do
  dest="$mod/hooks/kit"
  mkdir -p "$dest"
  changed=0
  for src in "${sources[@]}"; do
    name="$(basename "$src")"
    if ! cmp -s "$src" "$dest/$name"; then cp "$src" "$dest/$name"; changed=$((changed + 1)); fi
  done
  echo "${mod#$ROOT/}: $changed of ${#sources[@]} kit files updated"
  for file in "$dest"/*.ts "$dest"/*.tsx; do
    [[ -e "$KIT/$(basename "$file")" ]] || echo "  stale: ${file#$ROOT/} (not in kit/)"
  done
done
