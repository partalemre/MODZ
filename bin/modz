#!/usr/bin/env bash
# MODZ: the one source of these Claude Code mods. Marketplace name: modz
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODS="$ROOT/mods"
DEV_MODS="$HOME/.claude/dev-mods"
SKILLS="$HOME/.claude/skills"
# Cloud sessions see only the repo's own .claude/skills folder.
PROJECT_SKILLS="$ROOT/.claude/skills"
# Mods bound to this machine's sound, browser or disk: never linked for the cloud.
LOCAL_ONLY=" done-ping terminal-browser filetree "

usage() {
  cat <<USAGE
modz <command>
  list                 list the mods (version, when pinned, + description)
  new <name> [desc]    make a mod from templates/blank and add it to the marketplace
  check [name]         validate + test on the CLI and the desktop engine (all mods without a name)
  desk                 end to end on the desktop engine: hub rows, panes, the band and presses
  shot [--pane] [--title t] [out]
                       a PNG of the Claude window, covered or not (--pane: the right panel; --title: the
                       pop-out window whose title holds t, e.g. a session opened in its own window)
  sync                 bring marketplace.json in line with mods/
  import <folder>      copy a mod from a dev-mods folder into MODZ
  dev                  show every session mod under ~/.claude/dev-mods
  status               show whether each mod is linked
  link [name]          link a mod (or all) into ~/.claude/skills: it loads in every session
  unlink <name>        remove the link (the mod stays in MODZ)
  cloud                sync the .claude/skills links: cloud sessions load every mod not bound to this machine
USAGE
}

mod_names() { find "$MODS" -mindepth 2 -maxdepth 3 -path '*/.claude-plugin/plugin.json' | sed -E "s|$MODS/([^/]+)/.*|\1|" | sort; }

cmd_list() {
  for m in $(mod_names); do
    python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print("%-14s v%-8s %s" % (d["name"], d.get("version","-"), d.get("description","")))' "$MODS/$m/.claude-plugin/plugin.json"
  done
}

cmd_sync() {
  python3 - "$ROOT" <<'PY'
import json, os, sys
root = sys.argv[1]
path = os.path.join(root, ".claude-plugin", "marketplace.json")
market = json.load(open(path))
local = {n for n in os.listdir(os.path.join(root, "mods")) if os.path.isfile(os.path.join(root, "mods", n, ".claude-plugin", "plugin.json"))}
# Curated entries stay as written (order, wording, remote sources such as transceiver); a removed mod leaves,
# a new one joins at the end with its plugin.json description.
kept = [p for p in market["plugins"] if not isinstance(p["source"], str) or p["name"] in local]
known = {p["name"] for p in kept}
for name in sorted(local - known):
    d = json.load(open(os.path.join(root, "mods", name, ".claude-plugin", "plugin.json")))
    kept.append({"name": d["name"], "source": f"./mods/{name}", "description": d.get("description", "")})
market["plugins"] = kept
json.dump(market, open(path, "w"), indent=2, ensure_ascii=False)
open(path, "a").write("\n")
print(f"marketplace.json: {len(kept)} mod")
PY
}

cmd_new() {
  local name="${1:?a mod name is needed}" desc="${2:-A new mod}"
  [[ "$name" =~ ^[a-z0-9-]+$ ]] || { echo "a name holds only a-z, 0-9 and -" >&2; exit 1; }
  [[ -e "$MODS/$name" ]] && { echo "$name zaten var" >&2; exit 1; }
  cp -R "$ROOT/templates/blank" "$MODS/$name"
  NAME="$name" DESC="$desc" python3 - "$MODS/$name" <<'PY'
import os, sys, pathlib
for p in pathlib.Path(sys.argv[1]).rglob("*"):
    if p.is_file():
        s = p.read_text()
        p.write_text(s.replace("__NAME__", os.environ["NAME"]).replace("__DESC__", os.environ["DESC"]))
PY
  cmd_sync
  echo "made: $MODS/$name"
}

# The desktop app carries its own engine, often a release behind the CLI: a tree one accepts the other may
# refuse. The engine in the newest version folder; empty when there is none.
desktop_engine() {
  local base="$HOME/Library/Application Support/Claude/claude-code" newest bin
  newest="$(ls "$base" 2>/dev/null | sort -V | tail -1)"
  [[ -n "$newest" ]] || return 0
  for bin in "$base/$newest"/*/claude.app/Contents/MacOS/claude; do
    [[ -x "$bin" ]] && { echo "$bin"; return 0; }
  done
}

# validate + test with one engine; each line starts with the engine's name and version.
check_with() {
  local engine="$1" mod="$2" label out failed=0
  label="$3 $("$engine" --version 2>/dev/null | awk '{print $1}')"
  "$engine" plugin validate "$mod" >/dev/null 2>&1 && echo "  $label validate ✔" || { echo "  $label validate ✘"; failed=1; }
  if compgen -G "$mod/tests/*.test.ts*" >/dev/null; then
    out="$("$engine" plugin test "$mod" 2>&1)" || failed=1
    echo "  $label test: $(grep -E '^ *[0-9]+ (pass|fail)' <<<"$out" | xargs)"
  fi
  return $failed
}

cmd_check() {
  local targets=("${1:-}") desktop
  [[ -z "${1:-}" ]] && targets=($(mod_names))
  desktop="$(desktop_engine)"
  local failed=0
  # A pinned version freezes every user's copy until it is bumped; without one, each commit updates them.
  if grep -l '"version"' "$MODS"/*/.claude-plugin/plugin.json 2>/dev/null; then
    echo "✘ the files above pin a version; remove it so auto-update follows each commit"
    failed=1
  fi
  for m in "${targets[@]}"; do
    echo "== $m"
    check_with claude "$MODS/$m" cli || failed=1
    [[ -n "$desktop" ]] && { check_with "$desktop" "$MODS/$m" desktop || failed=1; }
  done
  return $failed
}

# The real desktop engine over the Code tab's control protocol: presses every hub row from an older tree.
cmd_desk() { python3 -I "$ROOT/tools/desk/check.py" "$ROOT"; }

# Agents cannot see the desktop app; this hands them its window. The panel crop is the right PANE_PT points.
PANE_PT=540
cmd_shot() {
  local pane=0 title="" out id w scale
  while [[ "${1:-}" == --* ]]; do
    case "$1" in --pane) pane=1; shift ;; --title) title="${2:?a title is needed}"; shift 2 ;; *) break ;; esac
  done
  out="${1:-${TMPDIR:-/tmp}/modz-shot.png}"
  # Largest window first: the main window, unless a title picks a pop-out.
  read -r id _ _ w _ < <(swift "$ROOT/tools/shot/windows.swift" Claude | grep -F -- "$title" | head -1) || true
  [[ -n "${id:-}" ]] || { echo "modz shot: no Claude window on screen" >&2; return 1; }
  # -o: no window shadow, -x: no sound. Needs Screen Recording for the app running this shell.
  screencapture -o -x -l"$id" "$out"
  if (( pane )); then
    scale=$(( $(sips -g pixelWidth "$out" | awk '/pixelWidth/{print $2}') / w ))
    sips -c "$(sips -g pixelHeight "$out" | awk '/pixelHeight/{print $2}')" $(( PANE_PT * scale )) \
      --cropOffset 0 $(( (w - PANE_PT) * scale )) "$out" >/dev/null
  fi
  echo "$out"
}

cmd_import() {
  local src="${1:?a source folder is needed}" name
  name="$(basename "$src")"
  rsync -a --exclude '.claude-plugin/types/' --exclude node_modules "$src/" "$MODS/$name/"
  cmd_sync
  echo "imported: $name"
}

cmd_dev() {
  find "$DEV_MODS" -mindepth 3 -maxdepth 4 -path '*/.claude-plugin/plugin.json' 2>/dev/null \
    | sed -E 's|/.claude-plugin/plugin.json||' | sort
}

is_local_only() { [[ "$LOCAL_ONLY" == *" $1 "* ]]; }

cmd_status() {
  for m in $(mod_names); do
    local target="$SKILLS/$m" state="off" cloud="cloud: no"
    if [[ -L "$target" && "$(readlink "$target")" == "$MODS/$m" ]]; then state="on"
    elif [[ -e "$target" ]]; then state="conflict: $target is not linked to MODZ"; fi
    if is_local_only "$m"; then cloud="cloud: local"
    elif [[ -L "$PROJECT_SKILLS/$m" ]]; then cloud="cloud: yes"; fi
    printf "%-18s %-8s %s\n" "$m" "$state" "$cloud"
  done
}

# Relative links: they work wherever the repo is cloned (the cloud included).
cmd_cloud() {
  mkdir -p "$PROJECT_SKILLS"
  for link in "$PROJECT_SKILLS"/*; do
    [[ -L "$link" ]] || continue
    local m; m="$(basename "$link")"
    if [[ ! -d "$MODS/$m" ]] || is_local_only "$m"; then rm "$link" && echo "out of the cloud: $m"; fi
  done
  for m in $(mod_names); do
    is_local_only "$m" && continue
    ln -sfn "../../mods/$m" "$PROJECT_SKILLS/$m"
  done
  echo "cloud: $(find "$PROJECT_SKILLS" -maxdepth 1 -type l | wc -l | tr -d ' ') mod (yerel kalan:${LOCAL_ONLY% })"
}

link_one() {
  local m="$1" target="$SKILLS/$1"
  [[ -d "$MODS/$m" ]] || { echo "$m yok" >&2; return 1; }
  if [[ -L "$target" ]]; then ln -sfn "$MODS/$m" "$target"
  elif [[ -e "$target" ]]; then echo "$target is a real folder; first 'modz import $target'" >&2; return 1
  else ln -s "$MODS/$m" "$target"; fi
  echo "aktif: $m"
}

cmd_link() {
  if [[ -n "${1:-}" ]]; then link_one "$1"; return; fi
  for m in $(mod_names); do link_one "$m"; done
}

cmd_unlink() {
  local target="$SKILLS/${1:?a mod name is needed}"
  [[ -L "$target" ]] || { echo "$target is not a link" >&2; exit 1; }
  rm "$target" && echo "off: $1"
}

case "${1:-}" in
  list) cmd_list ;;
  new) shift; cmd_new "$@" ;;
  check) shift; cmd_check "$@" ;;
  desk) cmd_desk ;;
  shot) shift; cmd_shot "$@" ;;
  sync) cmd_sync ;;
  import) shift; cmd_import "$@" ;;
  dev) cmd_dev ;;
  status) cmd_status ;;
  link) shift; cmd_link "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  cloud) cmd_cloud ;;
  *) usage ;;
esac
