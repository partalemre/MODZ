#!/usr/bin/env bash
# MODZ: Claude Code modlarının tek kaynağı. Marketplace adı: modz
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODS="$ROOT/mods"
DEV_MODS="$HOME/.claude/dev-mods"
SKILLS="$HOME/.claude/skills"
# Cloud oturumları yalnızca reponun kendi .claude/skills klasörünü görür.
PROJECT_SKILLS="$ROOT/.claude/skills"
# Bu makinenin sesine, tarayıcısına ya da diskine bağlı modlar: cloud'a bağlanmaz.
LOCAL_ONLY=" done-ping terminal-browser filetree "

usage() {
  cat <<USAGE
modz <komut>
  list                 modları listele (sürüm + açıklama)
  new <ad> [açıklama]  templates/blank'ten yeni mod oluştur ve marketplace'e ekle
  check [ad]           validate + test, CLI ve masaüstü motoruyla (ad verilmezse hepsi)
  desk                 masaüstü motoruyla uçtan uca: hub satırları, paneller, bant ve tıklamalar
  sync                 marketplace.json'u mods/ klasörüyle eşitle
  import <klasör>      bir dev-mods klasöründeki modu MODZ'a kopyala
  dev                  ~/.claude/dev-mods altındaki tüm oturum modlarını göster
  status               her modun etkin olup olmadığını göster
  link [ad]            modu (veya hepsini) ~/.claude/skills'e bağla: her oturumda yüklenir
  unlink <ad>          bağlantıyı kaldır (mod MODZ'da kalır)
  cloud                .claude/skills linklerini eşitle: cloud oturumları yerel olmayan her modu yükler
USAGE
}

mod_names() { find "$MODS" -mindepth 2 -maxdepth 3 -path '*/.claude-plugin/plugin.json' | sed -E "s|$MODS/([^/]+)/.*|\1|" | sort; }

cmd_list() {
  for m in $(mod_names); do
    python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print("%-14s v%-8s %s" % (d["name"], d.get("version","?"), d.get("description","")))' "$MODS/$m/.claude-plugin/plugin.json"
  done
}

cmd_sync() {
  python3 - "$ROOT" <<'PY'
import json, os, sys
root = sys.argv[1]
path = os.path.join(root, ".claude-plugin", "marketplace.json")
market = json.load(open(path))
plugins = []
for name in sorted(os.listdir(os.path.join(root, "mods"))):
    manifest = os.path.join(root, "mods", name, ".claude-plugin", "plugin.json")
    if not os.path.isfile(manifest):
        continue
    d = json.load(open(manifest))
    plugins.append({"name": d["name"], "source": f"./mods/{name}", "description": d.get("description", "")})
market["plugins"] = plugins
json.dump(market, open(path, "w"), indent=2, ensure_ascii=False)
open(path, "a").write("\n")
print(f"marketplace.json: {len(plugins)} mod")
PY
}

cmd_new() {
  local name="${1:?mod adı gerekli}" desc="${2:-Yeni mod}"
  [[ "$name" =~ ^[a-z0-9-]+$ ]] || { echo "ad sadece a-z, 0-9 ve - içerebilir" >&2; exit 1; }
  [[ -e "$MODS/$name" ]] && { echo "$name zaten var" >&2; exit 1; }
  cp -R "$ROOT/templates/blank" "$MODS/$name"
  NAME="$name" DESC="$desc" python3 - "$MODS/$name" <<'PY'
import os, sys, pathlib
for p in pathlib.Path(sys.argv[1]).rglob("*"):
    if p.is_file():
        s = p.read_text()
        p.write_text(s.replace("__NAME__", os.environ["NAME"]).replace("__DESC__", os.environ["DESC"]))
PY
  cmd_sync
  echo "oluşturuldu: $MODS/$name"
}

# Masaüstü uygulaması kendi motorunu taşır, çoğu zaman CLI'dan bir sürüm geride: birinin kabul ettiği ağacı
# öteki reddedebilir. En yeni sürüm klasöründeki motor; yoksa boş döner.
desktop_engine() {
  local base="$HOME/Library/Application Support/Claude/claude-code" newest bin
  newest="$(ls "$base" 2>/dev/null | sort -V | tail -1)"
  [[ -n "$newest" ]] || return 0
  for bin in "$base/$newest"/*/claude.app/Contents/MacOS/claude; do
    [[ -x "$bin" ]] && { echo "$bin"; return 0; }
  done
}

# Bir motorla validate + test; satırın başında motorun adı ve sürümü.
check_with() {
  local engine="$1" mod="$2" label out failed=0
  label="$3 $("$engine" --version 2>/dev/null | awk '{print $1}')"
  "$engine" plugin validate "$mod" >/dev/null 2>&1 && echo "  $label validate ✔" || { echo "  $label validate ✘"; failed=1; }
  if compgen -G "$mod/tests/*.test.ts*" >/dev/null; then
    out="$("$engine" plugin test "$mod" 2>&1)" || failed=1
    echo "  $label test: $(grep -E '^ *[0-9]+ (pass|fail)' <<<"$out" | xargs)"
  fi
  return $failed
}

cmd_check() {
  local targets=("${1:-}") desktop
  [[ -z "${1:-}" ]] && targets=($(mod_names))
  desktop="$(desktop_engine)"
  local failed=0
  for m in "${targets[@]}"; do
    echo "== $m"
    check_with claude "$MODS/$m" cli || failed=1
    [[ -n "$desktop" ]] && { check_with "$desktop" "$MODS/$m" desktop || failed=1; }
  done
  return $failed
}

# Gerçek masaüstü motoru, Code sekmesinin kontrol protokolüyle: her hub satırına eski ağaçtan basar.
cmd_desk() { python3 -I "$ROOT/tools/desk/check.py" "$ROOT"; }

cmd_import() {
  local src="${1:?kaynak klasör gerekli}" name
  name="$(basename "$src")"
  rsync -a --exclude '.claude-plugin/types/' --exclude node_modules "$src/" "$MODS/$name/"
  cmd_sync
  echo "içe aktarıldı: $name"
}

cmd_dev() {
  find "$DEV_MODS" -mindepth 3 -maxdepth 4 -path '*/.claude-plugin/plugin.json' 2>/dev/null \
    | sed -E 's|/.claude-plugin/plugin.json||' | sort
}

is_local_only() { [[ "$LOCAL_ONLY" == *" $1 "* ]]; }

cmd_status() {
  for m in $(mod_names); do
    local target="$SKILLS/$m" state="kapalı" cloud="cloud: yok"
    if [[ -L "$target" && "$(readlink "$target")" == "$MODS/$m" ]]; then state="aktif"
    elif [[ -e "$target" ]]; then state="çakışma: $target MODZ'a bağlı değil"; fi
    if is_local_only "$m"; then cloud="cloud: yerel"
    elif [[ -L "$PROJECT_SKILLS/$m" ]]; then cloud="cloud: var"; fi
    printf "%-18s %-8s %s\n" "$m" "$state" "$cloud"
  done
}

# Göreli linkler: repo nereye klonlanırsa klonlansın (cloud dahil) çalışır.
cmd_cloud() {
  mkdir -p "$PROJECT_SKILLS"
  for link in "$PROJECT_SKILLS"/*; do
    [[ -L "$link" ]] || continue
    local m; m="$(basename "$link")"
    if [[ ! -d "$MODS/$m" ]] || is_local_only "$m"; then rm "$link" && echo "cloud'dan çıktı: $m"; fi
  done
  for m in $(mod_names); do
    is_local_only "$m" && continue
    ln -sfn "../../mods/$m" "$PROJECT_SKILLS/$m"
  done
  echo "cloud: $(find "$PROJECT_SKILLS" -maxdepth 1 -type l | wc -l | tr -d ' ') mod (yerel kalan:${LOCAL_ONLY% })"
}

link_one() {
  local m="$1" target="$SKILLS/$1"
  [[ -d "$MODS/$m" ]] || { echo "$m yok" >&2; return 1; }
  if [[ -L "$target" ]]; then ln -sfn "$MODS/$m" "$target"
  elif [[ -e "$target" ]]; then echo "$target gerçek bir klasör; önce 'modz import $target'" >&2; return 1
  else ln -s "$MODS/$m" "$target"; fi
  echo "aktif: $m"
}

cmd_link() {
  if [[ -n "${1:-}" ]]; then link_one "$1"; return; fi
  for m in $(mod_names); do link_one "$m"; done
}

cmd_unlink() {
  local target="$SKILLS/${1:?mod adı gerekli}"
  [[ -L "$target" ]] || { echo "$target bir bağlantı değil" >&2; exit 1; }
  rm "$target" && echo "kapalı: $1"
}

case "${1:-}" in
  list) cmd_list ;;
  new) shift; cmd_new "$@" ;;
  check) shift; cmd_check "$@" ;;
  desk) cmd_desk ;;
  sync) cmd_sync ;;
  import) shift; cmd_import "$@" ;;
  dev) cmd_dev ;;
  status) cmd_status ;;
  link) shift; cmd_link "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  cloud) cmd_cloud ;;
  *) usage ;;
esac
